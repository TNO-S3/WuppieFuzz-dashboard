          "queryText": "SELECT strftime('%Y-%m-%dT%H:%M:%SZ', timestamp) as time, sequences_completed_total as \"Completed\", sequences_missing_backreference_total as \"Missing backreference\", sequences_crash_or_validation_total as \"Crash or validation\", sequences_transport_error_total as \"Transport error\", sequences_request_build_error_total as \"Request build error\" FROM stats WHERE runid = \"$runid\" ORDER BY timestamp",
